{
  "author": [
    "GAI-CTI"
  ],
  "description": "This rule is triggered when an IP address indicator from the Threat Intel Filebeat module or integrations has a match against a network event.",
  "from": "now-10h",
  "index": [
    "log*", 
    "*packetbeat*"
  ],
  "interval": "1h",
  "language": "kuery",
  "name": "Threat Intel IP Address Indicator Match",
  "query": "*:*",
  "required_fields": [
    {
      "ecs": true,
      "name": "destination.ip",
      "type": "text"
    },
    {
      "ecs": true,
      "name": "source.ip",
      "type": "text"
    }
  ],
  "risk_score": 99,
  "rule_id": "0c41e478-5263-4c69-8f9e-7dfd2c22da64",
  "severity": "critical",
  "tags": [
    "OS: Windows",
    "Data Source: Elastic Endgame",
    "Rule Type: Threat Match",
    "Resources: Investigation Guide",
    "Type: GAI_CTI_TI"
  ],
  "threat_index": [
    "opencti*"
  ],
  "threat_indicator_path": "threat.indicator",
  "threat_language": "kuery",
  "threat_mapping": [
    {
      "entries": [
        {
          "field": "source.ip",
          "type": "mapping",
          "value": "threatintel.indicator.ip.keyword"
        }
      ]
    },
    {
      "entries": [
        {
          "field": "destination.ip",
          "type": "mapping",
          "value": "threatintel.indicator.ip.keyword"
        }
      ]
    }
  ],
  "threat_query": "*:*",
  "type": "threat_match",
  "version": 8
}