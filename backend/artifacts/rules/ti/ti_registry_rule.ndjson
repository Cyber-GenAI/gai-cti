{
  "author": [
    "GAI-CTI"
  ],
  "description": "This rule is triggered when a Windows registry indicator from the Threat Intel Filebeat module or integrations has a match against an event that contains registry data.",
  "from": "now-10h",
  "index": [
    "log*",
    "*packetbeat*"
  ],
  "interval": "1h",
  "language": "kuery",
  "name": "Threat Intel Windows Registry Indicator Match",
  "query": "*:*",
  "required_fields": [
    {
      "ecs": true,
      "name": "registry.path",
      "type": "keyword"
    }
  ],
  "risk_score": 99,
  "rule_id": "a61809f3-fb5b-465c-8bff-23a8a068ac60",
  "severity": "critical",
  "tags": [
    "OS: Windows",
    "Data Source: Elastic Endgame",
    "Rule Type: Threat Match",
    "Resources: Investigation Guide",
    "Type: GAI_CTI_TI"
  ],
  "threat_index": [
    "opencti*"
  ],
  "threat_indicator_path": "threat.indicator",
  "threat_language": "kuery",
  "threat_mapping": [
    {
      "entries": [
        {
          "field": "registry.path",
          "type": "mapping",
          "value": "threatintel.indicator.registry.path.keyword"
        }
      ]
    }
  ],
  "threat_query": "*:*",
  "type": "threat_match",
  "version": 8
}