{
  "author": [
        "GAI-CTI"
  ],
  "description": "This rule is triggered when a URL indicator from the Threat Intel Filebeat module or integrations has a match against an event that contains URL data, like DNS events, network logs, etc.",
  "from": "now-10h",
  "index": [
    "log*",
    "*packetbeat*"
  ],
  "interval": "1h",
  "language": "kuery",
  "name": "Threat Intel URL Indicator Match",
  "query": "*:*",
  "required_fields": [
    {
      "ecs": true,
      "name": "url.full",
      "type": "wildcard"
    }
  ],
  "risk_score": 99,
  "rule_id": "f3e22c8b-ea47-45d1-b502-b57b6de950b3",
  "severity": "critical",
  "tags": [
    "OS: Windows",
    "Data Source: Elastic Endgame",
    "Rule Type: Threat Match",
    "Resources: Investigation Guide", 
    "Type: GAI_CTI_TI"
  ],
  
  "threat_index": [
    "opencti*"
  ],
  "threat_indicator_path": "threat.indicator",
  "threat_language": "kuery",
  "threat_mapping": [
    {
      "entries": [
        {
          "field": "url.full",
          "type": "mapping",
          "value": "threatintel.indicator.url.full.keyword"
        }
      ]
    },
    {
      "entries": [
        {
          "field": "url.original",
          "type": "mapping",
          "value": "threatintel.indicator.url.original.keyword"
        }
      ]
    }
  ],
  "threat_query": "*:*",
  "type": "threat_match",
  "version": 8
}