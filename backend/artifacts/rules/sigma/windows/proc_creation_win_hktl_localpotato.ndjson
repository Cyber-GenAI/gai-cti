  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the execution of the LocalPotato POC based on basic PE metadata information and default CLI examples",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unlikely"
  ],
  "from": "now-360s",
  "rule_id": "a47e4674-2ed2-43bd-ab3d-717ea50e09e8",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://www.localpotato.com/localpotato_html/LocalPotato.html",
