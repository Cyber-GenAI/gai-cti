  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\LocalPotato.exe OR (process.command_line:*.exe\\ \\-i\\ C\\:\\\\* AND process.command_line:*\\-o\\ Windows\\\\*) OR (winlog.event_data.Hashes:(*IMPHASH\\=E1742EE971D6549E8D4D81115F88F1FC* OR *IMPHASH\\=DD82066EFBA94D7556EF582F247C8BB5*))"
