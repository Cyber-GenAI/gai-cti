    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:*\\\\netsh.exe OR process.pe.original_file_name:netsh.exe) AND (process.command_line:*firewall* AND process.command_line:*delete\\ *)) AND (NOT (process.parent.executable:*\\\\Dropbox.exe AND process.command_line:*name\\=Dropbox*))"
