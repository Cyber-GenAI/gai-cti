  "query": "(process.executable:*\\\\dotnet.exe OR process.pe.original_file_name:.NET\\ Host) AND (process.command_line:(*.csproj OR *.csproj\\\" OR *.dll OR *.dll\\\" OR *.csproj' OR *.dll'))"
