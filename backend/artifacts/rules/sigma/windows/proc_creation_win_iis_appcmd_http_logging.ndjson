  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\appcmd.exe OR process.pe.original_file_name:appcmd.exe) AND (process.command_line:*set* AND process.command_line:*config* AND process.command_line:*section\\:httplogging* AND process.command_line:*dontLog\\:true*)"
}