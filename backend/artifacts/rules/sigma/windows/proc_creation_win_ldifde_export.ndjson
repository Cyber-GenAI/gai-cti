{
  "id": "4067dc10-6b06-4c70-be7c-ebf103a1f065",
  "name": "Active Directory Structure Export Via Ldifde.EXE",
  "tags": [
    "attack.exfiltration",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the execution of \"ldifde.exe\" in order to export organizational Active Directory structure.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "58f618f1-0122-499c-b3cf-b9b3ceff6cb5",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://businessinsights.bitdefender.com/deep-dive-into-a-backdoordiplomacy-attack-a-study-of-an-attackers-toolkit",
    "https://www.documentcloud.org/documents/5743766-Global-Threat-Report-2019.html",
    "https://learn.microsoft.com/en-us/previous-versions/windows/it-pro/windows-server-2012-r2-and-2012/cc731033(v=ws.11)"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:*\\\\ldifde.exe OR process.pe.original_file_name:ldifde.exe) AND process.command_line:*\\-f*) AND (NOT process.command_line:*\\ \\-i*)"
}