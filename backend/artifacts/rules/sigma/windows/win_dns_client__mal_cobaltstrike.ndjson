    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects a program that invoked suspicious DNS queries known from Cobalt Strike beacons",
  "risk_score": 100,
  "severity": "critical",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
