{
  "id": "b0183169-ca00-4b9b-92c5-d2814a632ca4",
  "name": "Network Connection Initiated To DevTunnels Domain",
  "tags": [
    "attack.exfiltration",
    "attack.t1567.001",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects network connections to Devtunnels domains initiated by a process on a system. Attackers can abuse that feature to establish a reverse shell or persistence on a machine.\n",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate use of Devtunnels will also trigger this."
  ],
  "from": "now-360s",
  "rule_id": "8e5ca6ba-d8a6-49dd-ae2f-1129cb2fa6f8",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0010",
        "name": "Exfiltration",
        "reference": "https://attack.mitre.org/tactics/TA0010/"
      },
      "technique": [
        {
          "id": "T1567",
          "name": "Exfiltration Over Web Service",
          "reference": "https://attack.mitre.org/techniques/T1567/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://blueteamops.medium.com/detecting-dev-tunnels-16f0994dc3e2",
    "https://learn.microsoft.com/en-us/azure/developer/dev-tunnels/security",
    "https://cydefops.com/devtunnels-unleashed"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "network.direction:true AND destination.domain:*.devtunnels.ms"
}