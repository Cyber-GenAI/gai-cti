  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\sc.exe AND (process.command_line:*config* AND process.command_line:*binPath*) AND (process.command_line:(*powershell* OR *cmd\\ * OR *mshta* OR *wscript* OR *cscript* OR *rundll32* OR *svchost* OR *dllhost* OR *cmd.exe\\ \\/c* OR *cmd.exe\\ \\/k* OR *cmd.exe\\ \\/r* OR *cmd\\ \\/c* OR *cmd\\ \\/k* OR *cmd\\ \\/r* OR *C\\:\\\\Users\\\\Public* OR *\\\\Downloads\\\\* OR *\\\\Desktop\\\\* OR *\\\\Microsoft\\\\Windows\\\\Start\\ Menu\\\\Programs\\\\Startup\\\\* OR *C\\:\\\\Windows\\\\TEMP\\\\* OR *\\\\AppData\\\\Local\\\\Temp*))"
}