  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.pe.product:SQLite OR (process.executable:(*\\\\sqlite.exe OR *\\\\sqlite3.exe))) AND (process.command_line:(*\\\\User\\ Data\\\\* OR *\\\\Opera\\ Software\\\\* OR *\\\\ChromiumViewer\\\\*)) AND (process.command_line:(*Login\\ Data* OR *Cookies* OR *Web\\ Data* OR *History* OR *Bookmarks*))"
