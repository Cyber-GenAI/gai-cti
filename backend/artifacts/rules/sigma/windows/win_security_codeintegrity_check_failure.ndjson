  ],
  "from": "now-360s",
  "rule_id": "3dcfa731-06ce-49b5-9ca4-d0fc8ed52370",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1027",
          "name": "Obfuscated Files or Information",
          "reference": "https://attack.mitre.org/techniques/T1027/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://learn.microsoft.com/en-us/previous-versions/windows/it-pro/windows-10/security/threat-protection/auditing/event-5038",
    "https://learn.microsoft.com/en-us/previous-versions/windows/it-pro/windows-10/security/threat-protection/auditing/event-6281"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "winlog.channel:Security AND ((event.code:(5038 OR 6281)) AND (NOT ((winlog.event_data.param1:(*\\\\CSFalconServiceUninstallTool_* OR *\\\\Program\\ Files\\\\CrowdStrike\\\\* OR *\\\\System32\\\\drivers\\\\CrowdStrike\\\\* OR *\\\\Windows\\\\System32\\\\ScriptControl64_*)) OR winlog.event_data.param1:*\\\\Program\\ Files\\\\Sophos\\\\*)))"
