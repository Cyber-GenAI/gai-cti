    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects a suspicious process spawning from an Outlook process.",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
