  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:(*\\:\\\\Windows\\\\System32\\\\bash.exe OR *\\:\\\\Windows\\\\SysWOW64\\\\bash.exe)) OR process.pe.original_file_name:Bash.exe) AND process.command_line:*\\ \\-c\\ *"
