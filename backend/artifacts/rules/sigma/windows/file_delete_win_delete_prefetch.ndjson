  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(file.path:*\\:\\\\Windows\\\\Prefetch\\\\* AND file.path:*.pf) AND (NOT (process.executable:*\\:\\\\windows\\\\system32\\\\svchost.exe AND (user.name:(*AUTHORI* OR *AUTORI*))))"
