  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "dns.question.name:_ldap.* AND (NOT ((process.executable:(*\\:\\\\Program\\ Files\\\\* OR *\\:\\\\Program\\ Files\\ \\(x86\\)\\\\* OR *\\:\\\\Windows\\\\*)) OR (process.executable:*\\:\\\\ProgramData\\\\Microsoft\\\\Windows\\ Defender\\\\Platform\\\\* AND process.executable:*\\\\MsMpEng.exe) OR process.executable:\\<unknown\\ process\\> OR (NOT _exists_:process.executable))) AND (NOT (process.executable:C\\:\\\\WindowsAzure\\\\GuestAgent* OR (process.executable:(*\\\\chrome.exe OR *\\\\firefox.exe OR *\\\\opera.exe))))"
}