    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\secedit.exe OR process.pe.original_file_name:SeCEdit) AND ((process.command_line:*\\/export* AND process.command_line:*\\/cfg*) OR (process.command_line:*\\/configure* AND process.command_line:*\\/db*))"
