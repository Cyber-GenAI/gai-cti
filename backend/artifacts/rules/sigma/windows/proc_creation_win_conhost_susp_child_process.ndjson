{
  "id": "50c23bae-bff3-4b53-9a63-cebbdbdd67bb",
  "name": "Uncommon Child Process Of Conhost.EXE",
  "tags": [
    "attack.defense-evasion",
    "attack.t1202",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects uncommon \"conhost\" child processes. This could be a sign of \"conhost\" usage as a LOLBIN or potential process injection activity.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "23615c8e-6b44-4e5c-964c-c03d16043b80",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1202",
          "name": "Indirect Command Execution",
          "reference": "https://attack.mitre.org/techniques/T1202/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "http://www.hexacorn.com/blog/2020/05/25/how-to-con-your-host/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.parent.executable:*\\\\conhost.exe AND (NOT (process.executable:*\\:\\\\Windows\\\\System32\\\\conhost.exe OR (NOT _exists_:process.executable) OR process.executable:\"\")) AND (NOT winlog.provider_name:SystemTraceProvider\\-Process)"
}