    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(registry.path:*\\\\Word\\\\Security\\\\AllowDDE AND (winlog.event_data.Details:(DWORD\\ \\(0x00000001\\) OR DWORD\\ \\(0x00000002\\)))) OR ((registry.path:(*\\\\Excel\\\\Security\\\\DisableDDEServerLaunch OR *\\\\Excel\\\\Security\\\\DisableDDEServerLookup)) AND winlog.event_data.Details:DWORD\\ \\(0x00000000\\))"
}