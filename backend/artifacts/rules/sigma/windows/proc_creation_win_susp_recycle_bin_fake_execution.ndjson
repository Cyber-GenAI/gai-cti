{
  "id": "560b0619-cdad-44c8-a055-fb11949a29c6",
  "name": "Suspicious Process Execution From Fake Recycle.Bin Folder",
  "tags": [
    "attack.persistence",
    "attack.defense-evasion",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects process execution from a fake recycle bin folder, often used to avoid security solution.",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unlikely"
  ],
  "from": "now-360s",
  "rule_id": "6ccf7244-afa1-439e-9b1f-347ff7b49ece",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://www.mandiant.com/resources/blog/infected-usb-steal-secrets",
    "https://unit42.paloaltonetworks.com/cloaked-ursa-phishing/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:(*RECYCLERS.BIN\\\\* OR *RECYCLER.BIN\\\\*)"
}