{
  "id": "858a11f9-02a9-4165-8308-4099ab0a5e75",
  "name": "Potential Signing Bypass Via Windows Developer Features",
  "tags": [
    "attack.defense-evasion",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects when a user enable developer features such as \"Developer Mode\" or \"Application Sideloading\". Which allows the user to install untrusted packages.",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "619240b1-c1e9-44b1-b821-abe407fd1cf6",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "Internal Research",
    "https://www.sentinelone.com/labs/inside-malicious-windows-apps-for-malware-deployment/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\SystemSettingsAdminFlows.exe OR process.pe.original_file_name:SystemSettingsAdminFlows.EXE) AND process.command_line:*TurnOnDeveloperFeatures* AND (process.command_line:(*DeveloperUnlock* OR *EnableSideloading*))"
}