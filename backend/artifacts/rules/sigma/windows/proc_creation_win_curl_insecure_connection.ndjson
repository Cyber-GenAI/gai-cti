{
  "id": "9ae3f39e-8b87-4c1c-9892-d0689121eb41",
  "name": "Insecure Transfer Via Curl.EXE",
  "tags": [
    "attack.execution",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects execution of \"curl.exe\" with the \"--insecure\" flag.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Access to badly maintained internal or development systems"
  ],
  "from": "now-360s",
  "rule_id": "8e04a4ea-1087-4724-b53c-858e0eed5247",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://curl.se/docs/manpage.html"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\curl.exe OR process.pe.original_file_name:curl.exe) AND (process.command_line:/\\s-k\\s/ OR process.command_line:*\\-\\-insecure*)"
}