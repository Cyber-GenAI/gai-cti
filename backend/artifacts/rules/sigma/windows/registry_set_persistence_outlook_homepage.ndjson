  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(registry.path:*\\\\Software\\\\Microsoft\\\\Office\\\\* AND registry.path:*\\\\Outlook\\\\WebView\\\\*) AND registry.path:*\\\\URL"
