  "query": "file.path:*\\\\vssapi.dll AND (NOT (((process.executable:(C\\:\\\\Windows\\\\explorer.exe OR C\\:\\\\Windows\\\\ImmersiveControlPanel\\\\SystemSettings.exe)) OR (process.executable:(C\\:\\\\Windows\\\\System32\\\\* OR C\\:\\\\Windows\\\\SysWOW64\\\\* OR C\\:\\\\Windows\\\\Temp\\\\\\{* OR C\\:\\\\Windows\\\\WinSxS\\\\*))) OR (process.executable:(C\\:\\\\Program\\ Files\\\\* OR C\\:\\\\Program\\ Files\\ \\(x86\\)\\\\*)) OR process.executable:C\\:\\\\ProgramData\\\\Package\\ Cache\\\\*))"
}