  "name": "Perl Inline Command Execution",
  "tags": [
    "attack.execution",
    "attack.t1059",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
