  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(winlog.event_data.EventType:DeleteValue AND registry.path:*\\\\Microsoft\\\\Terminal\\ Server\\ Client\\\\Default\\\\MRU*) OR (winlog.event_data.EventType:DeleteKey AND registry.path:*\\\\Microsoft\\\\Terminal\\ Server\\ Client\\\\Servers\\\\*)"
}