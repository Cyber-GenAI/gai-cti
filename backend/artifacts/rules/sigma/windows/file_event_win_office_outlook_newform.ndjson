  "query": "process.executable:*\\\\outlook.exe AND (file.path:(*\\\\AppData\\\\Local\\\\Microsoft\\\\FORMS\\\\IPM* OR *\\\\Local\\ Settings\\\\Application\\ Data\\\\Microsoft\\\\Forms*))"
