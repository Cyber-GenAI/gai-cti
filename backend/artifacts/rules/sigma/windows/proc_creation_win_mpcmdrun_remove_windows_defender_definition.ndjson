    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\MpCmdRun.exe OR process.pe.original_file_name:MpCmdRun.exe) AND (process.command_line:*\\ \\-RemoveDefinitions* AND process.command_line:*\\ \\-All*)"
