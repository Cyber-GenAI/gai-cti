  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:*\\\\whoami.exe OR process.pe.original_file_name:whoami.exe) AND (process.command_line:(*\\ \\/FO\\ CSV* OR *\\ \\-FO\\ CSV*))) OR process.command_line:*whoami*\\>*"
