  "query": "winlog.channel:Security AND ((event.code:4674 AND winlog.event_data.ObjectType:SC_MANAGER\\ OBJECT AND winlog.event_data.ObjectName:servicesactive AND winlog.event_data.PrivilegeList:SeTakeOwnershipPrivilege) AND (NOT (winlog.logon.id:0x3e4 AND process.executable:*\\:\\\\Windows\\\\System32\\\\services.exe)))"
