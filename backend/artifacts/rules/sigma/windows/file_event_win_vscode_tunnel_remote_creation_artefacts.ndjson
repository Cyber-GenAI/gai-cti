{
  "id": "cc1c0555-ad0e-4d3f-98a0-218362f95906",
  "name": "Visual Studio Code Tunnel Remote File Creation",
  "tags": [
    "attack.command-and-control",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the creation of file by the \"node.exe\" process in the \".vscode-server\" directory. Could be a sign of remote file creation via VsCode tunnel feature\n",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "afc6333a-87c7-4e4c-a739-984b930d6a6d",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "Internal Research"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\servers\\\\Stable\\-* AND process.executable:*\\\\server\\\\node.exe AND file.path:*\\\\.vscode\\-server\\\\data\\\\User\\\\History\\\\*"
}