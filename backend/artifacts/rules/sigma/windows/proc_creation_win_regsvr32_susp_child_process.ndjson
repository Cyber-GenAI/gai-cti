  "query": "(process.parent.executable:*\\\\regsvr32.exe AND (process.executable:(*\\\\calc.exe OR *\\\\cscript.exe OR *\\\\explorer.exe OR *\\\\mshta.exe OR *\\\\net.exe OR *\\\\net1.exe OR *\\\\nltest.exe OR *\\\\notepad.exe OR *\\\\powershell.exe OR *\\\\pwsh.exe OR *\\\\reg.exe OR *\\\\schtasks.exe OR *\\\\werfault.exe OR *\\\\wscript.exe))) AND (NOT (process.executable:*\\\\werfault.exe AND process.command_line:*\\ \\-u\\ \\-p\\ *))"
}