  "query": "winlog.event_data.Type:Image\\ is\\ replaced AND (NOT (process.executable:(*\\:\\\\Program\\ Files\\ \\(x86\\)* OR *\\:\\\\Program\\ Files\\\\* OR *\\:\\\\Windows\\\\System32\\\\wbem\\\\WMIADAP.exe* OR *\\:\\\\Windows\\\\SysWOW64\\\\wbem\\\\WMIADAP.exe*))) AND (NOT ((process.executable:*\\\\AppData\\\\Local\\\\Programs\\\\Opera\\\\* AND process.executable:*\\\\opera.exe) OR process.executable:*\\\\WindowsApps\\\\MicrosoftEdge.exe))"
