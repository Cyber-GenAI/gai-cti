{
  "id": "b65b0148-d086-45c5-94d7-ade1de0add5d",
  "name": "Microsoft IIS Service Account Password Dumped",
  "tags": [
    "attack.credential-access",
    "attack.t1003",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the Internet Information Services (IIS) command-line tool, AppCmd, being used to list passwords",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "4fb74c01-1e62-4626-a552-630de0f88caf",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0006",
        "name": "Credential Access",
        "reference": "https://attack.mitre.org/tactics/TA0006/"
      },
      "technique": [
        {
          "id": "T1003",
          "name": "OS Credential Dumping",
          "reference": "https://attack.mitre.org/techniques/T1003/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://www.elastic.co/guide/en/security/current/microsoft-iis-service-account-password-dumped.html",
    "https://twitter.com/0gtweet/status/1588815661085917186?cxt=HHwWhIDUyaDbzYwsAAAA",
    "https://www.netspi.com/blog/technical/network-penetration-testing/decrypting-iis-passwords-to-break-out-of-the-dmz-part-2/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:*\\\\appcmd.exe OR process.pe.original_file_name:appcmd.exe) AND process.command_line:*list\\ *) AND ((process.command_line:(*\\ \\/config* OR *\\ \\/xml* OR *\\ \\-config* OR *\\ \\-xml*)) OR ((process.command_line:(*\\ \\/@t* OR *\\ \\/text* OR *\\ \\/show* OR *\\ \\-@t* OR *\\ \\-text* OR *\\ \\-show*)) AND (process.command_line:(*\\:\\** OR *password*))))"
}