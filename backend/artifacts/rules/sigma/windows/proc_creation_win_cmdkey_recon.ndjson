  "query": "(process.executable:*\\\\cmdkey.exe OR process.pe.original_file_name:cmdkey.exe) AND process.command_line:(*\\ \\-l* OR *\\ \\/l* OR *\\ \u2013l* OR *\\ \u2014l* OR *\\ \u2015l*)"
