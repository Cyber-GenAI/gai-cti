{
  "id": "a526483e-fc6c-4555-b09a-68031d660052",
  "name": "Outlook Security Settings Updated - Registry",
  "tags": [
    "attack.persistence",
    "attack.t1137",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects changes to the registry values related to outlook security settings",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Administrative activity"
  ],
  "from": "now-360s",
  "rule_id": "35057fe3-f483-48cc-bfa5-0e302bffd8a9",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0003",
        "name": "Persistence",
        "reference": "https://attack.mitre.org/tactics/TA0003/"
      },
      "technique": [
        {
          "id": "T1137",
          "name": "Office Application Startup",
          "reference": "https://attack.mitre.org/techniques/T1137/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1137/T1137.md",
    "https://learn.microsoft.com/en-us/outlook/troubleshoot/security/information-about-email-security-settings"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "registry.path:*\\\\SOFTWARE\\\\Microsoft\\\\Office\\\\* AND registry.path:*\\\\Outlook\\\\Security\\\\*"
}