  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "registry.path:*\\\\Services\\\\LanmanServer\\\\Parameters\\\\* AND (registry.path:(*\\\\AutoShareWks OR *\\\\AutoShareServer)) AND winlog.event_data.Details:DWORD\\ \\(0x00000000\\)"
}