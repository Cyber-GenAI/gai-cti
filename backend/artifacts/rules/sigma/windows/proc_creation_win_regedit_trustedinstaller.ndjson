{
  "id": "9ff590a6-39ae-4ec9-ba82-56902a521c67",
  "name": "Regedit as Trusted Installer",
  "tags": [
    "attack.privilege-escalation",
    "attack.t1548",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects a regedit started with TrustedInstaller privileges or by ProcessHacker.exe",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unlikely"
  ],
  "from": "now-360s",
  "rule_id": "b25956ff-0087-476a-9689-ae21b3b615db",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0004",
        "name": "Privilege Escalation",
        "reference": "https://attack.mitre.org/tactics/TA0004/"
      },
      "technique": [
        {
          "id": "T1548",
          "name": "Abuse Elevation Control Mechanism",
          "reference": "https://attack.mitre.org/techniques/T1548/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://twitter.com/1kwpeter/status/1397816101455765504"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\regedit.exe AND (process.parent.executable:(*\\\\TrustedInstaller.exe OR *\\\\ProcessHacker.exe))"
}