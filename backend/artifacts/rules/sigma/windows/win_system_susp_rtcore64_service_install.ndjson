{
  "id": "e1b76884-e969-47f7-ab18-2c7e892f2110",
  "name": "RTCore Suspicious Service Installation",
  "tags": [
    "attack.persistence",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the installation of RTCore service. Which could be an indication of Micro-Star MSI Afterburner vulnerable driver abuse",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "1cb2b2da-6179-4e1f-847b-1ef34e2bf226",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://github.com/br-sn/CheekyBlinder/blob/e1764a8a0e7cda8a3716aefa35799f560686e01c/CheekyBlinder/CheekyBlinder.cpp"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "winlog.channel:System AND (winlog.provider_name:Service\\ Control\\ Manager AND event.code:7045 AND winlog.event_data.ServiceName:RTCore64)"
}