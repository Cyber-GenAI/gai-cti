{
  "id": "0cd4e6f4-cf79-4a96-b029-dd766a18cb80",
  "name": "Suspicious File Execution From Internet Hosted WebDav Share",
  "tags": [
    "attack.execution",
    "attack.t1059.001",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the execution of the \"net use\" command to mount a WebDAV server and then immediately execute some content in it. As seen being used in malicious LNK files",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "bf3f6514-6d50-45c4-b12f-91107ed8e516",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0002",
        "name": "Execution",
        "reference": "https://attack.mitre.org/tactics/TA0002/"
      },
      "technique": [
        {
          "id": "T1059",
          "name": "Command and Scripting Interpreter",
          "reference": "https://attack.mitre.org/techniques/T1059/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://twitter.com/ShadowChasing1/status/1552595370961944576",
    "https://www.virustotal.com/gui/file/a63376ee1dba76361df73338928e528ca5b20171ea74c24581605366dcaa0104/behavior"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\cmd.exe* OR process.pe.original_file_name:Cmd.EXE) AND (process.command_line:*\\ net\\ use\\ http* AND process.command_line:*\\&\\ start\\ \\/b\\ * AND process.command_line:*\\\\DavWWWRoot\\\\*) AND (process.command_line:(*.exe\\ * OR *.dll\\ * OR *.bat\\ * OR *.vbs\\ * OR *.ps1\\ *))"
}