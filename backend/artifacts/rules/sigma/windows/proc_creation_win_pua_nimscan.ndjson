{
  "id": "b8571898-f6e5-4748-98a7-21b37384d3f4",
  "name": "PUA - NimScan Execution",
  "tags": [
    "attack.discovery",
    "attack.t1046",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects usage of NimScan, a portscanner utility.\nIn early 2025, adversaries were observed using this utility to scan for open ports on remote hosts in a compromised environment.\nThis rule identifies the execution of NimScan based on the process image name and specific hash values associated with different versions of the tool.\n",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate administrator activity"
  ],
  "from": "now-360s",
  "rule_id": "78581092-893d-4a3f-9bbd-e2911f674974",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0007",
        "name": "Discovery",
        "reference": "https://attack.mitre.org/tactics/TA0007/"
      },
      "technique": [
        {
          "id": "T1046",
          "name": "Network Service Discovery",
          "reference": "https://attack.mitre.org/techniques/T1046/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://x.com/cyberfeeddigest/status/1887041526397587859",
    "https://github.com/elddy/NimScan"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\NimScan.exe OR (winlog.event_data.Hashes:(*IMPHASH\\=41BB1C7571B3A724EB83A1D2B96DBB8C* OR *IMPHASH\\=B1B6ADACB172795480179EFD18A29549* OR *IMPHASH\\=0D1F896DC7642AD8384F9042F30279C2*))"
}