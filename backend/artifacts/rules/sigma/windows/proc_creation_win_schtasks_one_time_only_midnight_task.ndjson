  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\schtasks.exe* OR process.pe.original_file_name:schtasks.exe) AND (process.command_line:(*wscript* OR *vbscript* OR *cscript* OR *wmic\\ * OR *wmic.exe* OR *regsvr32.exe* OR *powershell* OR *\\\\AppData\\\\*)) AND (process.command_line:*once* AND process.command_line:*00\\:00*)"
