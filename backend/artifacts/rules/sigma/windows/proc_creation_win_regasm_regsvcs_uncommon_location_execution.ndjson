    "log*"
  ],
  "query": "((process.executable:(*\\\\Regsvcs.exe OR *\\\\Regasm.exe)) OR (process.pe.original_file_name:(RegSvcs.exe OR RegAsm.exe))) AND (process.command_line:(*\\\\AppData\\\\Local\\\\Temp\\\\* OR *\\\\Microsoft\\\\Windows\\\\Start\\ Menu\\\\Programs\\\\Startup\\\\* OR *\\\\PerfLogs\\\\* OR *\\\\Users\\\\Public\\\\* OR *\\\\Windows\\\\Temp\\\\*))"
