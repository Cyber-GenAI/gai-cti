  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "powershell.file.script_block_text:*\\[System.Net.HttpWebRequest\\]* AND powershell.file.script_block_text:*System.Net.Sockets.TcpListener* AND powershell.file.script_block_text:*AcceptTcpClient*"
