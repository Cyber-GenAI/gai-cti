  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\certoc.exe OR process.pe.original_file_name:CertOC.exe) AND process.command_line:(*\\ \\-LoadDLL\\ * OR *\\ \\/LoadDLL\\ * OR *\\ \u2013LoadDLL\\ * OR *\\ \u2014LoadDLL\\ * OR *\\ \u2015LoadDLL\\ *) AND (process.command_line:(*\\\\Appdata\\\\Local\\\\Temp\\\\* OR *\\\\Desktop\\\\* OR *\\\\Downloads\\\\* OR *\\\\Users\\\\Public\\\\* OR *C\\:\\\\Windows\\\\Tasks\\\\* OR *C\\:\\\\Windows\\\\Temp\\\\*))"
}