{
  "id": "145a0aff-70ff-4e2d-8984-7e2db78aebdd",
  "name": "Service Installed By Unusual Client - Security",
  "tags": [
    "attack.privilege-escalation",
    "attack.t1543",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects a service installed by a client which has PID 0 or whose parent has PID 0",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "4d458673-87b6-4002-9b4c-24ac7a06654b",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0004",
        "name": "Privilege Escalation",
        "reference": "https://attack.mitre.org/tactics/TA0004/"
      },
      "technique": [
        {
          "id": "T1543",
          "name": "Create or Modify System Process",
          "reference": "https://attack.mitre.org/techniques/T1543/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://www.elastic.co/guide/en/security/current/windows-service-installed-via-an-unusual-client.html",
    "https://www.x86matthew.com/view_post?id=create_svc_rpc",
    "https://twitter.com/SBousseaden/status/1490608838701166596"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "winlog.channel:Security AND (event.code:4697 AND (winlog.event_data.ClientProcessId:0 OR process.parent.pid:0))"
}