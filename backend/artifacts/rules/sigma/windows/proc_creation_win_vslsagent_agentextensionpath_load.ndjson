{
  "id": "ddf9a89b-c242-4601-a4fa-789bdb18376e",
  "name": "Suspicious Vsls-Agent Command With AgentExtensionPath Load",
  "tags": [
    "attack.defense-evasion",
    "attack.t1218",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects Microsoft Visual Studio vsls-agent.exe lolbin execution with a suspicious library load using the --agentExtensionPath parameter",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "False positives depend on custom use of vsls-agent.exe"
  ],
  "from": "now-360s",
  "rule_id": "f9c116fb-83ed-4752-98ca-2dfc123d8dd5",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1218",
          "name": "System Binary Proxy Execution",
          "reference": "https://attack.mitre.org/techniques/T1218/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://twitter.com/bohops/status/1583916360404729857"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\vsls\\-agent.exe AND process.command_line:*\\-\\-agentExtensionPath*) AND (NOT process.command_line:*Microsoft.VisualStudio.LiveShare.Agent.*)"
}