        "name": "Persistence",
        "reference": "https://attack.mitre.org/tactics/TA0003/"
      },
      "technique": [
        {
          "id": "T1546",
          "name": "Event Triggered Execution",
          "reference": "https://attack.mitre.org/techniques/T1546/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "http://www.hexacorn.com/blog/2013/01/19/beyond-good-ol-run-key-part-3/",
