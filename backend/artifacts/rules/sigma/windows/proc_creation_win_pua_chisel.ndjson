  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\chisel.exe OR ((process.command_line:(*exe\\ client\\ * OR *exe\\ server\\ *)) AND (process.command_line:(*\\-socks5* OR *\\-reverse* OR *\\ r\\:* OR *\\:127.0.0.1\\:* OR *\\-tls\\-skip\\-verify\\ * OR *\\:socks*)))"
