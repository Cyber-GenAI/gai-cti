{
  "id": "09bb825b-9ea5-4ce0-a695-aac88fff3983",
  "name": "Windows Defender Threat Detection Service Disabled",
  "tags": [
    "attack.defense-evasion",
    "attack.t1562.001",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects when the \"Windows Defender Threat Protection\" service is disabled.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Administrator actions",
    "Auto updates of Windows Defender causes restarts"
  ],
  "from": "now-360s",
  "rule_id": "17eda726-1dc2-4421-8c4a-fbb0bd744d66",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1562",
          "name": "Impair Defenses",
          "reference": "https://attack.mitre.org/techniques/T1562/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://learn.microsoft.com/en-us/defender-endpoint/troubleshoot-microsoft-defender-antivirus",
    "https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1562.001/T1562.001.md"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "winlog.channel:System AND (event.code:7036 AND winlog.provider_name:Service\\ Control\\ Manager AND (winlog.event_data.param1:(Windows\\ Defender\\ Antivirus\\ Service OR Service\\ antivirus\\ Microsoft\\ Defender)) AND (winlog.event_data.param2:(stopped OR arr\u00eat\u00e9)))"
}