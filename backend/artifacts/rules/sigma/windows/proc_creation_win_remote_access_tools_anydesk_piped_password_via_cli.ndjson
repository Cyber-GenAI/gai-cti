{
  "id": "5c8030d5-c66c-480f-85f3-200847cfb0c8",
  "name": "Remote Access Tool - AnyDesk Piped Password Via CLI",
  "tags": [
    "attack.command-and-control",
    "attack.t1219",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects piping the password to an anydesk instance via CMD and the '--set-password' flag.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate piping of the password to anydesk",
    "Some FP could occur with similar tools that uses the same command line '--set-password'"
  ],
  "from": "now-360s",
  "rule_id": "451e7e17-d572-416c-851e-a7bbfe9313ae",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0011",
        "name": "Command And Control",
        "reference": "https://attack.mitre.org/tactics/TA0011/"
      },
      "technique": [
        {
          "id": "T1219",
          "name": "Remote Access Tools",
          "reference": "https://attack.mitre.org/techniques/T1219/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://redcanary.com/blog/misbehaving-rats/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.command_line:*\\/c\\ * AND process.command_line:*echo\\ * AND process.command_line:*.exe\\ \\-\\-set\\-password*"
}