{
  "id": "4a93bdde-5142-48d5-a9f4-ca0be2d5d776",
  "name": "Suspicious Msiexec Quiet Install From Remote Location",
  "tags": [
    "attack.defense-evasion",
    "attack.t1218.007",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects usage of Msiexec.exe to install packages hosted remotely quietly",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "9898dd6f-c254-4b34-bb49-e7ed6efed2e0",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1218",
          "name": "System Binary Proxy Execution",
          "reference": "https://attack.mitre.org/techniques/T1218/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://www.microsoft.com/en-us/security/blog/2022/10/27/raspberry-robin-worm-part-of-larger-ecosystem-facilitating-pre-ransomware-activity/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\msiexec.exe OR process.pe.original_file_name:msiexec.exe) AND (process.command_line:(*\\-i* OR *\\/i* OR *\u2013i* OR *\u2014i* OR *\u2015i*) OR process.command_line:(*\\-package* OR *\\/package* OR *\u2013package* OR *\u2014package* OR *\u2015package*) OR process.command_line:(*\\-a* OR *\\/a* OR *\u2013a* OR *\u2014a* OR *\u2015a*) OR process.command_line:(*\\-j* OR *\\/j* OR *\u2013j* OR *\u2014j* OR *\u2015j*)) AND process.command_line:(*\\-q* OR *\\/q* OR *\u2013q* OR *\u2014q* OR *\u2015q*) AND (process.command_line:(*http* OR *\\\\\\\\*))"
}