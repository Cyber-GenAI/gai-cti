{
  "id": "1671d621-5c5a-46e2-9559-1e13d0123156",
  "name": "Potential Persistence Via Mpnotify",
  "tags": [
    "attack.persistence",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects when an attacker register a new SIP provider for persistence and defense evasion",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Might trigger if a legitimate new SIP provider is registered. But this is not a common occurrence in an environment and should be investigated either way"
  ],
  "from": "now-360s",
  "rule_id": "857b08dd-4c35-42e0-95f2-faa186a9a930",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://persistence-info.github.io/Data/mpnotify.html",
    "https://www.youtube.com/watch?v=ggY3srD9dYs&ab_channel=GrzegorzTworek"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "registry.path:*\\\\SOFTWARE\\\\Microsoft\\\\Windows\\ NT\\\\CurrentVersion\\\\Winlogon\\\\mpnotify*"
}