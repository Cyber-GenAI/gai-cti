    "log*"
  ],
  "query": "(process.command_line:*findstr* OR process.executable:*findstr.exe OR process.pe.original_file_name:FINDSTR.EXE) AND (process.command_line:(*\\ \\-s\\ * OR *\\ \\/s\\ * OR *\\ \u2013s\\ * OR *\\ \u2014s\\ * OR *\\ \u2015s\\ *) AND process.command_line:(*\\ \\-i\\ * OR *\\ \\/i\\ * OR *\\ \u2013i\\ * OR *\\ \u2014i\\ * OR *\\ \u2015i\\ *))"
