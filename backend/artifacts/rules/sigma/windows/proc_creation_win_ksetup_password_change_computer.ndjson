{
  "id": "6cc03dd3-e990-4eee-bed5-f367d479fa4d",
  "name": "Computer Password Change Via Ksetup.EXE",
  "tags": [
    "attack.execution",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects password change for the computer's domain account or host principal via \"ksetup.exe\"",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "4e81b399-9477-4824-a730-e3b7411834e5",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://twitter.com/Oddvarmoe/status/1641712700605513729",
    "https://learn.microsoft.com/en-gb/windows-server/administration/windows-commands/ksetup"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\ksetup.exe OR process.pe.original_file_name:ksetup.exe) AND process.command_line:*\\ \\/setcomputerpassword\\ *"
}