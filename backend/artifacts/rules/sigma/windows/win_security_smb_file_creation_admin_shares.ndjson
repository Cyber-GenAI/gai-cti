  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "winlog.channel:Security AND ((event.code:5145 AND winlog.event_data.ShareName:*C$ AND winlog.event_data.AccessMask:0x2) AND (NOT user.name:*$))"
