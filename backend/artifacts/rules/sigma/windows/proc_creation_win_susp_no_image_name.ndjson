  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Rare legitimate software."
  ],
  "from": "now-360s",
  "rule_id": "46a7b87d-070d-49bf-8d5f-f34072182f7b",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
