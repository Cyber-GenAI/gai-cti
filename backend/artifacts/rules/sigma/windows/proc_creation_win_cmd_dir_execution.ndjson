{
  "id": "a4114348-00d7-46d7-97a6-6a5657eea048",
  "name": "File And SubFolder Enumeration Via Dir Command",
  "tags": [
    "attack.discovery",
    "attack.t1217",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects usage of the \"dir\" command part of Widows CMD with the \"/S\" command line flag in order to enumerate files in a specified directory and all subdirectories.\n",
  "risk_score": 20,
  "severity": "low",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Likely"
  ],
  "from": "now-360s",
  "rule_id": "50884927-9882-4ab8-aa6c-8d25c607bf29",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0007",
        "name": "Discovery",
        "reference": "https://attack.mitre.org/tactics/TA0007/"
      },
      "technique": [
        {
          "id": "T1217",
          "name": "Browser Information Discovery",
          "reference": "https://attack.mitre.org/techniques/T1217/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1217/T1217.md"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\cmd.exe OR process.pe.original_file_name:Cmd.Exe) AND process.command_line:(*dir*\\-s* OR *dir*\\/s* OR *dir*\u2013s* OR *dir*\u2014s* OR *dir*\u2015s*)"
}