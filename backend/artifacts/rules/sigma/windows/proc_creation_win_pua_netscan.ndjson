    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\netscan.exe OR process.pe.product:Network\\ Scanner OR process.pe.description:Application\\ for\\ scanning\\ networks"
