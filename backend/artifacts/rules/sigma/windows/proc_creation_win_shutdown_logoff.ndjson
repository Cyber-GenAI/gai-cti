      },
      "technique": [
        {
          "id": "T1529",
          "name": "System Shutdown/Reboot",
          "reference": "https://attack.mitre.org/techniques/T1529/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
