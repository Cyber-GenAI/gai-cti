  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.pe.original_file_name:Cmd.Exe OR process.executable:*\\\\cmd.exe) AND (process.command_line:(*Invoke\\-UserHunter* OR *Invoke\\-ShareFinder* OR *Invoke\\-Kerberoast* OR *Invoke\\-SMBAutoBrute* OR *Invoke\\-Nightmare* OR *zerologon* OR *av_query*))"
