  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\loader.exe AND process.command_line:*\\-\\-pid\\:*) OR (winlog.event_data.Hashes:(*IMPHASH\\=38D9E015591BBFD4929E0D0F47FA0055* OR *IMPHASH\\=0E2216679CA6E1094D63322E3412D650*)) OR ((process.command_line:*\\-\\-pid\\:* AND process.command_line:*\\-\\-outfile\\:*) AND (process.command_line:(*.dmp* OR *lsass* OR *.obf* OR *dump*)))"
}