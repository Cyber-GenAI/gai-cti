  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:*\\\\schtasks.exe OR process.pe.original_file_name:schtasks.exe) AND process.command_line:*\\/Create* AND (process.command_line:(*Get\\-ItemProperty* OR *\\ gp\\ *)) AND (process.command_line:(*HKCU\\:* OR *HKLM\\:* OR *registry\\:\\:* OR *HKEY_*))) AND (NOT (process.command_line:(*FromBase64String* OR *encodedcommand*)))"
}