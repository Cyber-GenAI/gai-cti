  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\reg.exe AND (process.command_line:*SOFTWARE\\\\Microsoft\\\\Cryptography* AND process.command_line:*\\/v\\ * AND process.command_line:*MachineGuid*)"
