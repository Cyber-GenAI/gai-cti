{
  "id": "aa650139-78ea-430b-b911-f27b32ad4f89",
  "name": "Whoami.EXE Execution Anomaly",
  "tags": [
    "attack.discovery",
    "attack.t1033",
    "car.2016-03-001",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the execution of whoami.exe with suspicious parent processes.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Admin activity",
    "Scripts and administrative tools used in the monitored environment",
    "Monitoring activity"
  ],
  "from": "now-360s",
  "rule_id": "107096da-6b1c-4af1-875e-45a074e42f47",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0007",
        "name": "Discovery",
        "reference": "https://attack.mitre.org/tactics/TA0007/"
      },
      "technique": [
        {
          "id": "T1033",
          "name": "System Owner/User Discovery",
          "reference": "https://attack.mitre.org/techniques/T1033/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://brica.de/alerts/alert/public/1247926/agent-tesla-keylogger-delivered-inside-a-power-iso-daa-archive/",
    "https://app.any.run/tasks/7eaba74e-c1ea-400f-9c17-5e30eee89906/",
    "https://www.youtube.com/watch?v=DsJ9ByX84o4&t=6s"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\whoami.exe OR process.pe.original_file_name:whoami.exe) AND (NOT ((process.parent.executable:(*\\\\cmd.exe OR *\\\\powershell_ise.exe OR *\\\\powershell.exe OR *\\\\pwsh.exe)) OR (NOT _exists_:process.parent.executable) OR (process.parent.executable:(\"\" OR \\-)))) AND (NOT process.parent.executable:*\\:\\\\Program\\ Files\\\\Microsoft\\ Monitoring\\ Agent\\\\Agent\\\\MonitoringHost.exe)"
}