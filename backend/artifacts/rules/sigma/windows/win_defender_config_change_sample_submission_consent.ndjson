    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "winlog.channel:Microsoft\\-Windows\\-Windows\\ Defender\\/Operational AND (event.code:5007 AND winlog.event_data.NewValue:*\\\\Real\\-Time\\ Protection\\\\SubmitSamplesConsent\\ \\=\\ 0x0*)"
