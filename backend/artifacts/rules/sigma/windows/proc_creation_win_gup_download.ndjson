{
  "id": "6f529104-7197-4d29-aed0-8f6e7ed60358",
  "name": "File Download Using Notepad++ GUP Utility",
  "tags": [
    "attack.command-and-control",
    "attack.t1105",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects execution of the Notepad++ updater (gup) from a process other than Notepad++ to download files.",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Other parent processes other than notepad++ using GUP that are not currently identified"
  ],
  "from": "now-360s",
  "rule_id": "fb6b8929-6099-4d38-9eb3-ba806391cb7c",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0011",
        "name": "Command And Control",
        "reference": "https://attack.mitre.org/tactics/TA0011/"
      },
      "technique": [
        {
          "id": "T1105",
          "name": "Ingress Tool Transfer",
          "reference": "https://attack.mitre.org/techniques/T1105/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://twitter.com/nas_bench/status/1535322182863179776"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:*\\\\GUP.exe OR process.pe.original_file_name:gup.exe) AND (process.command_line:*\\ \\-unzipTo\\ * AND process.command_line:*http*)) AND (NOT process.parent.executable:*\\\\notepad\\+\\+.exe)"
}