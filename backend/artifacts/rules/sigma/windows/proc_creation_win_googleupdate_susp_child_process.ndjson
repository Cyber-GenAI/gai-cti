{
  "id": "2392fc92-9c82-419a-bc63-50b7123d6dbe",
  "name": "Potentially Suspicious GoogleUpdate Child Process",
  "tags": [
    "attack.defense-evasion",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects potentially suspicious child processes of \"GoogleUpdate.exe\"",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "f2534ab6-71f9-4bd6-840c-532a2cb41b8b",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://www.ncsc.gov.uk/static-assets/documents/malware-analysis-reports/goofy-guineapig/NCSC-MAR-Goofy-Guineapig.pdf"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.parent.executable:*\\\\GoogleUpdate.exe AND (NOT ((process.executable:*\\\\Google* OR (process.executable:(*\\\\setup.exe OR *chrome_updater.exe OR *chrome_installer.exe))) OR (NOT _exists_:process.executable)))"
}