  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\schtasks.exe AND (process.command_line:*\\/Create* AND process.command_line:*\\/RU* AND process.command_line:*\\/TR* AND process.command_line:*C\\:\\\\Users\\\\* AND process.command_line:*\\\\AppData\\\\Local\\\\*) AND (process.command_line:(*NT\\ AUT* OR *\\ SYSTEM\\ *))) AND (NOT ((process.parent.executable:*\\\\AppData\\\\Local\\\\Temp\\\\* AND process.parent.executable:*TeamViewer_.exe*) AND process.executable:*\\\\schtasks.exe AND process.command_line:*\\/TN\\ TVInstallRestore*))"
}