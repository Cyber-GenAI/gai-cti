{
  "id": "c8027b5c-676e-4aa1-b1d0-9d0fe6123bac",
  "name": "Renamed VsCode Code Tunnel Execution - File Indicator",
  "tags": [
    "attack.command-and-control",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the creation of a file with the name \"code_tunnel.json\" which indicate execution and usage of VsCode tunneling utility by an \"Image\" or \"Process\" other than VsCode.\n",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "47ddd51f-6f35-40bb-8519-5732edc1036c",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://ipfyx.fr/post/visual-studio-code-tunnel/",
    "https://badoption.eu/blog/2023/01/31/code_c2.html"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "file.path:*\\\\code_tunnel.json AND (NOT (process.executable:(*\\\\code\\-tunnel.exe OR *\\\\code.exe)))"
}