{
  "id": "11626a07-f606-4f1d-aaea-6d3001cac9ea",
  "name": "Suspicious Rundll32 Execution With Image Extension",
  "tags": [
    "attack.defense-evasion",
    "attack.t1218.011",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the execution of Rundll32.exe with DLL files masquerading as image files",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "97c7f13c-c267-4aa8-a034-a040e2dd2101",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1218",
          "name": "System Binary Proxy Execution",
          "reference": "https://attack.mitre.org/techniques/T1218/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://www.zscaler.com/blogs/security-research/onenote-growing-threat-malware-distribution"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\rundll32.exe OR process.pe.original_file_name:RUNDLL32.exe) AND (process.command_line:(*.bmp* OR *.cr2* OR *.eps* OR *.gif* OR *.ico* OR *.jpeg* OR *.jpg* OR *.nef* OR *.orf* OR *.png* OR *.raw* OR *.sr2* OR *.tif* OR *.tiff*))"
}