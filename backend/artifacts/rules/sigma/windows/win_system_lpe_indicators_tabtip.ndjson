  "query": "winlog.channel:System AND (winlog.provider_name:Microsoft\\-Windows\\-DistributedCOM AND event.code:10001 AND winlog.event_data.param1:C\\:\\\\Program\\ Files\\\\Common\\ Files\\\\microsoft\\ shared\\\\ink\\\\TabTip.exe AND winlog.event_data.param2:2147943140 AND winlog.event_data.param3:\\{054AAE20\\-4BEA\\-4347\\-8A35\\-64A533254A9D\\})"
}