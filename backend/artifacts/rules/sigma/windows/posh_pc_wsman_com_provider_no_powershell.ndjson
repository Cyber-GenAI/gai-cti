  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "winlog.channel:Windows\\ PowerShell AND (winlog.event_data.Data:*ProviderName\\=WSMan* AND (NOT ((winlog.event_data.Data:(*HostApplication\\=powershell* OR *HostApplication\\=C\\:\\\\Windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell* OR *HostApplication\\=C\\:\\\\Windows\\\\SysWOW64\\\\WindowsPowerShell\\\\v1.0\\\\powershell* OR *HostApplication\\=C\\:\\/Windows\\/System32\\/WindowsPowerShell\\/v1.0\\/powershell* OR *HostApplication\\=C\\:\\/Windows\\/SysWOW64\\/WindowsPowerShell\\/v1.0\\/powershell*)) OR winlog.event_data.Data:/HostId=[a-zA-Z0-9-]{36}\\s+EngineVersion=/)))"
}