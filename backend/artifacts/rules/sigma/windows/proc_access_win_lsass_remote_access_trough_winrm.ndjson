  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(winlog.event_data.TargetImage:*\\\\lsass.exe AND process.executable:*\\:\\\\Windows\\\\system32\\\\wsmprovhost.exe) AND (NOT winlog.event_data.GrantedAccess:0x80000000)"
