  "query": "(process.executable:*\\\\certutil.exe OR process.pe.original_file_name:CertUtil.exe) AND process.command_line:(*\\-encode* OR *\\/encode* OR *\u2013encode* OR *\u2014encode* OR *\u2015encode*) AND (process.command_line:(*.acl* OR *.bat* OR *.doc* OR *.gif* OR *.jpeg* OR *.jpg* OR *.mp3* OR *.pdf* OR *.png* OR *.ppt* OR *.tmp* OR *.xls* OR *.xml*))"
