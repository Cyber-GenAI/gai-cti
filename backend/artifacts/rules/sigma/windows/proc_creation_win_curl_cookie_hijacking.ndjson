{
  "id": "f96233b5-363a-4e80-887f-d1e852a12820",
  "name": "Potential Cookies Session Hijacking",
  "tags": [
    "attack.execution",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects execution of \"curl.exe\" with the \"-c\" flag in order to save cookie data.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "61ba5bac-3d79-473f-bfdd-bfd49fa2e9c7",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://curl.se/docs/manpage.html"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\curl.exe OR process.pe.original_file_name:curl.exe) AND (process.command_line:/\\s-c\\s/ OR process.command_line:*\\-\\-cookie\\-jar*)"
}