  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\unregmp2.exe OR process.pe.original_file_name:unregmp2.exe) AND process.command_line:(*\\ \\-HideWMP* OR *\\ \\/HideWMP* OR *\\ \u2013HideWMP* OR *\\ \u2014HideWMP* OR *\\ \u2015HideWMP*)"
}