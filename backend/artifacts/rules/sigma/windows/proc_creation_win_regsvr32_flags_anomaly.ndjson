  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\regsvr32.exe AND process.command_line:(*\\ \\-i\\:* OR *\\ \\/i\\:* OR *\\ \u2013i\\:* OR *\\ \u2014i\\:* OR *\\ \u2015i\\:*)) AND (NOT process.command_line:(*\\ \\-n\\ * OR *\\ \\/n\\ * OR *\\ \u2013n\\ * OR *\\ \u2014n\\ * OR *\\ \u2015n\\ *))"
}