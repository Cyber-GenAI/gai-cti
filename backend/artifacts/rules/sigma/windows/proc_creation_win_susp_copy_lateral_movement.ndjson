{
  "id": "7a41acd3-ad90-4d17-940e-88d3332bf78e",
  "name": "Copy From Or To Admin Share Or Sysvol Folder",
  "tags": [
    "attack.lateral-movement",
    "attack.collection",
    "attack.exfiltration",
    "attack.t1039",
    "attack.t1048",
    "attack.t1021.002",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects a copy command or a copy utility execution to or from an Admin share or remote",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Administrative scripts"
  ],
  "from": "now-360s",
  "rule_id": "380f14c2-0c9f-4ca9-aecf-39d0421f908f",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
