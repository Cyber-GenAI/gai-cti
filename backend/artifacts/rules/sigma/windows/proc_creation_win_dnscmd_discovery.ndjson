{
  "id": "d8cb41ac-6a58-4f16-a49a-47669e7035d9",
  "name": "Potential Discovery Activity Via Dnscmd.EXE",
  "tags": [
    "attack.discovery",
    "attack.execution",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects an attempt to leverage dnscmd.exe to enumerate the DNS zones of a domain. DNS zones used to host the DNS records for a particular domain.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate administration use"
  ],
  "from": "now-360s",
  "rule_id": "b9ecb1c7-9684-43f6-bc24-5efb96edc676",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/dnscmd",
    "https://learn.microsoft.com/en-us/azure/dns/dns-zones-records",
    "https://lolbas-project.github.io/lolbas/Binaries/Dnscmd/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\dnscmd.exe AND (process.command_line:(*\\/enumrecords* OR *\\/enumzones* OR *\\/ZonePrint* OR *\\/info*))"
}