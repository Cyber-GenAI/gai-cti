{
  "id": "f0ea7048-fc91-4be1-9942-999fa7ec365b",
  "name": "Hidden Powershell in Link File Pattern",
  "tags": [
    "attack.execution",
    "attack.t1059.001",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects events that appear when a user click on a link file with a powershell command in it",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate commands in .lnk files"
  ],
  "from": "now-360s",
  "rule_id": "7dd2a878-de07-4840-a691-afceb59485cd",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0002",
        "name": "Execution",
        "reference": "https://attack.mitre.org/tactics/TA0002/"
      },
      "technique": [
        {
          "id": "T1059",
          "name": "Command and Scripting Interpreter",
          "reference": "https://attack.mitre.org/techniques/T1059/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://www.x86matthew.com/view_post?id=embed_exe_lnk"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.parent.executable:C\\:\\\\Windows\\\\explorer.exe AND process.executable:C\\:\\\\Windows\\\\System32\\\\cmd.exe AND (process.command_line:*powershell* AND process.command_line:*.lnk*)"
}