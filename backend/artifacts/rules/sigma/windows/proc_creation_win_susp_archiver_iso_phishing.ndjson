{
  "id": "69ce7d27-d825-423a-ba11-538b5e491342",
  "name": "Phishing Pattern ISO in Archive",
  "tags": [
    "attack.initial-access",
    "attack.t1566",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects cases in which an ISO files is opend within an archiver like 7Zip or Winrar, which is a sign of phishing as threat actors put small ISO files in archives as email attachments to bypass certain filters and protective measures (mark of web)",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate cases in which archives contain ISO or IMG files and the user opens the archive and the image via clicking and not extraction"
  ],
  "from": "now-360s",
  "rule_id": "8bf4be0b-948e-4364-a4c9-a9c4bd42d298",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0001",
        "name": "Initial Access",
        "reference": "https://attack.mitre.org/tactics/TA0001/"
      },
      "technique": [
        {
          "id": "T1566",
          "name": "Phishing",
          "reference": "https://attack.mitre.org/techniques/T1566/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://twitter.com/1ZRR4H/status/1534259727059787783",
    "https://app.any.run/tasks/e1fe6a62-bce8-4323-a49a-63795d9afd5d/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.parent.executable:(*\\\\Winrar.exe OR *\\\\7zFM.exe OR *\\\\peazip.exe)) AND (process.executable:(*\\\\isoburn.exe OR *\\\\PowerISO.exe OR *\\\\ImgBurn.exe))"
}