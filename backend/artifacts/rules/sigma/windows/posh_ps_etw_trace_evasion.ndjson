  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "powershell.file.script_block_text:*Remove\\-EtwTraceProvider\\ * OR (powershell.file.script_block_text:*Set\\-EtwTraceProvider\\ * AND powershell.file.script_block_text:*0x11*)"
}