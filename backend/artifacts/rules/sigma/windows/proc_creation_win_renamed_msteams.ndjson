{
  "id": "fe7ec9c5-4ea6-4f1c-bf72-263929bc767a",
  "name": "Renamed Microsoft Teams Execution",
  "tags": [
    "attack.defense-evasion",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the execution of a renamed Microsoft Teams binary.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "ce83c593-e381-4906-97f8-2122eabf5508",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "Internal Research"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.pe.original_file_name:(msteams.exe OR teams.exe)) AND (NOT (process.executable:(*\\\\msteams.exe OR *\\\\teams.exe)))"
}