{
  "id": "83e91203-fa07-4651-8f70-c9eed30ce21d",
  "name": "Potentially Suspicious Usage Of Qemu",
  "tags": [
    "attack.command-and-control",
    "attack.t1090",
    "attack.t1572",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects potentially suspicious execution of the Qemu utility in a Windows environment.\nThreat actors have leveraged this utility and this technique for achieving network access as reported by Kaspersky.\n",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "0abee814-9d27-4e95-8e52-bf30843678c3",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0011",
        "name": "Command And Control",
        "reference": "https://attack.mitre.org/tactics/TA0011/"
      },
      "technique": [
        {
          "id": "T1090",
          "name": "Proxy",
          "reference": "https://attack.mitre.org/techniques/T1090/",
          "subtechnique": []
        },
        {
          "id": "T1572",
          "name": "Protocol Tunneling",
          "reference": "https://attack.mitre.org/techniques/T1572/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://securelist.com/network-tunneling-with-qemu/111803/",
    "https://www.qemu.org/docs/master/system/invocation.html#hxtool-5"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.command_line:(*\\-m\\ 1M* OR *\\-m\\ 2M* OR *\\-m\\ 3M*)) AND (process.command_line:*restrict\\=off* AND process.command_line:*\\-netdev\\ * AND process.command_line:*connect\\=* AND process.command_line:*\\-nographic*)) AND (NOT (process.command_line:(*\\ \\-cdrom\\ * OR *\\ type\\=virt\\ * OR *\\ \\-blockdev\\ *)))"
}