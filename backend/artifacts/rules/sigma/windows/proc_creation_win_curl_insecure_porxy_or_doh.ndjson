{
  "id": "8fa0630e-be00-499d-98b4-968e2d7548b2",
  "name": "Insecure Proxy/DOH Transfer Via Curl.EXE",
  "tags": [
    "attack.execution",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects execution of \"curl.exe\" with the \"insecure\" flag over proxy or DOH.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Access to badly maintained internal or development systems"
  ],
  "from": "now-360s",
  "rule_id": "c7baa377-1495-43a8-8d73-31e6929529f3",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://curl.se/docs/manpage.html"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\curl.exe OR process.pe.original_file_name:curl.exe) AND (process.command_line:(*\\-\\-doh\\-insecure* OR *\\-\\-proxy\\-insecure*))"
}