  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(((process.executable:(*\\\\powershell.exe OR *\\\\pwsh.exe)) AND (process.command_line:(*\\ \\|\\ iex;* OR *\\ \\|\\ iex\\ * OR *\\ \\|\\ iex\\}* OR *\\ \\|\\ IEX\\ ;* OR *\\ \\|\\ IEX\\ \\-Error* OR *\\ \\|\\ IEX\\ \\(new* OR *\\);IEX\\ *))) AND (process.command_line:(*\\:\\:FromBase64String* OR *.GetString\\(\\[System.Convert\\]\\:\\:*))) OR (process.command_line:(*\\)\\|iex;$* OR *\\);iex\\($* OR *\\);iex\\ $* OR *\\ \\|\\ IEX\\ \\|\\ * OR *\\ \\|\\ iex\\\\\\\"*))"
}