  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\svchost.exe AND file.path:*\\\\Personalization\\\\LockScreenImage\\\\*) AND (NOT file.path:*C\\:\\\\Windows\\\\*) AND (NOT (file.path:(*.jpg* OR *.jpeg* OR *.png*)))"
}