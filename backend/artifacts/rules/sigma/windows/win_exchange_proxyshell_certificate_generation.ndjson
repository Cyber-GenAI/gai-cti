  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "winlog.channel:MSExchange\\ Management AND ((*New\\-ExchangeCertificate* AND *\\ \\-GenerateRequest* AND *\\ \\-BinaryEncoded* AND *\\ \\-RequestFile*) AND (*\\\\\\\\localhost\\\\C$* OR *\\\\\\\\127.0.0.1\\\\C$* OR *C\\:\\\\inetpub* OR *.aspx*))"
