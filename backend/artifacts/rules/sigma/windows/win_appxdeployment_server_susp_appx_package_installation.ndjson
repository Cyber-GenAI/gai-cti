{
  "id": "7f293365-95ca-4e8f-8fb5-dd9985e8fde1",
  "name": "Suspicious AppX Package Installation Attempt",
  "tags": [
    "attack.defense-evasion",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects an appx package installation with the error code \"0x80073cff\" which indicates that the package didn't meet the signing requirements and could be suspicious",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate AppX packages not signed by MS used part of an enterprise"
  ],
  "from": "now-360s",
  "rule_id": "ddd5f2ab-dc81-4630-9234-b83f84c56d78",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "Internal Research",
    "https://www.sentinelone.com/labs/inside-malicious-windows-apps-for-malware-deployment/",
    "https://learn.microsoft.com/en-us/windows/win32/appxpkg/troubleshooting",
    "https://news.sophos.com/en-us/2021/11/11/bazarloader-call-me-back-attack-abuses-windows-10-apps-mechanism/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "winlog.channel:Microsoft\\-Windows\\-AppXDeploymentServer\\/Operational AND (event.code:401 AND winlog.event_data.ErrorCode:0x80073cff)"
}