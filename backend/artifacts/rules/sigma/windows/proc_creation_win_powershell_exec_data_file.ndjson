  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.command_line:(*iex\\ * OR *Invoke\\-Expression\\ * OR *Invoke\\-Command\\ * OR *icm\\ *)) AND (process.command_line:(*cat\\ * OR *get\\-content\\ * OR *type\\ *)) AND process.command_line:*\\ \\-raw*"
}