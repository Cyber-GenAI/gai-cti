  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\msdt.exe OR process.pe.original_file_name:msdt.exe) AND process.command_line:(*\\ \\-cab\\ * OR *\\ \\/cab\\ * OR *\\ \u2013cab\\ * OR *\\ \u2014cab\\ * OR *\\ \u2015cab\\ *)"
