{
  "id": "38db31dc-ff39-416c-8540-1fbf932fe48c",
  "name": "LiveKD Kernel Memory Dump File Created",
  "tags": [
    "attack.defense-evasion",
    "attack.privilege-escalation",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the creation of a file that has the same name as the default LiveKD kernel memory dump.",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "In rare occasions administrators might leverage LiveKD to perform live kernel debugging. This should not be allowed on production systems. Investigate and apply additional filters where necessary."
  ],
  "from": "now-360s",
  "rule_id": "22ae4042-2360-47dc-85a8-13b66f8502a2",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "Internal Research"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "file.path:C\\:\\\\Windows\\\\livekd.dmp"
}