    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:*\\\\regedit.exe OR process.pe.original_file_name:REGEDIT.EXE) AND ((process.command_line:(*\\ \\/i\\ * OR *.reg*)) AND process.command_line:/:[^ \\\\]/)) AND (NOT (process.command_line:(*\\ \\-e\\ * OR *\\ \\/e\\ * OR *\\ \u2013e\\ * OR *\\ \u2014e\\ * OR *\\ \u2015e\\ *) OR process.command_line:(*\\ \\-a\\ * OR *\\ \\/a\\ * OR *\\ \u2013a\\ * OR *\\ \u2014a\\ * OR *\\ \u2015a\\ *) OR process.command_line:(*\\ \\-c\\ * OR *\\ \\/c\\ * OR *\\ \u2013c\\ * OR *\\ \u2014c\\ * OR *\\ \u2015c\\ *)))"
