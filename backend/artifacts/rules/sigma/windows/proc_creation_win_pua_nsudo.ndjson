  "query": "((process.executable:(*\\\\NSudo.exe OR *\\\\NSudoLC.exe OR *\\\\NSudoLG.exe)) OR (process.pe.original_file_name:(NSudo.exe OR NSudoLC.exe OR NSudoLG.exe))) AND (process.command_line:(*\\-U\\:S\\ * OR *\\-U\\:T\\ * OR *\\-U\\:E\\ * OR *\\-P\\:E\\ * OR *\\-M\\:S\\ * OR *\\-M\\:H\\ * OR *\\-U\\=S\\ * OR *\\-U\\=T\\ * OR *\\-U\\=E\\ * OR *\\-P\\=E\\ * OR *\\-M\\=S\\ * OR *\\-M\\=H\\ * OR *\\-ShowWindowMode\\:Hide*))"
