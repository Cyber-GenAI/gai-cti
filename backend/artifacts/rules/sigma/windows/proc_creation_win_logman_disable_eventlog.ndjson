  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\logman.exe OR process.pe.original_file_name:Logman.exe) AND (process.command_line:(*stop\\ * OR *delete\\ *)) AND (process.command_line:(*Circular\\ Kernel\\ Context\\ Logger* OR *EventLog\\-* OR *SYSMON\\ TRACE* OR *SysmonDnsEtwSession*))"
}