    "attack.initial-access",
    "attack.t1078.001",
    "attack.t1078.002",
    "attack.t1078.003",
    "car.2016-04-005",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
