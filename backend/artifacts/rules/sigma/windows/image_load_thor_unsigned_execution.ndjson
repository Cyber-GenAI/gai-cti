{
  "id": "eeba8321-1a62-4c0e-b995-380a8545df35",
  "name": "Suspicious Unsigned Thor Scanner Execution",
  "tags": [
    "attack.defense-evasion",
    "attack.t1574.001",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects loading and execution of an unsigned thor scanner binary.",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Other legitimate binaries named \"thor.exe\" that aren't published by Nextron Systems"
  ],
  "from": "now-360s",
  "rule_id": "bd5f62a0-b0c0-47be-a50f-0e4f3599eb0f",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1574",
          "name": "Hijack Execution Flow",
          "reference": "https://attack.mitre.org/techniques/T1574/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "Internal Research"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:(*\\\\thor.exe OR *\\\\thor64.exe)) AND (file.path:(*\\\\thor.exe OR *\\\\thor64.exe))) AND (NOT (file.code_signature.signed:true AND file.code_signature.status:valid AND winlog.event_data.Signature:Nextron\\ Systems\\ GmbH))"
}