{
  "id": "d029c6c6-baca-4192-a4b9-483dd5bb26ed",
  "name": "Legitimate Application Dropped Archive",
  "tags": [
    "attack.defense-evasion",
    "attack.t1218",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects programs on a Windows system that should not write an archive to disk",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "a70590ce-f61d-43c5-bc23-8b5f8b901554",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1218",
          "name": "System Binary Proxy Execution",
          "reference": "https://attack.mitre.org/techniques/T1218/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://github.com/Neo23x0/sysmon-config/blob/3f808d9c022c507aae21a9346afba4a59dd533b9/sysmonconfig-export-block.xml#L1326"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:(*\\\\winword.exe OR *\\\\excel.exe OR *\\\\powerpnt.exe OR *\\\\msaccess.exe OR *\\\\mspub.exe OR *\\\\eqnedt32.exe OR *\\\\visio.exe OR *\\\\wordpad.exe OR *\\\\wordview.exe OR *\\\\certutil.exe OR *\\\\certoc.exe OR *\\\\CertReq.exe OR *\\\\Desktopimgdownldr.exe OR *\\\\esentutl.exe OR *\\\\finger.exe OR *\\\\notepad.exe OR *\\\\AcroRd32.exe OR *\\\\RdrCEF.exe OR *\\\\mshta.exe OR *\\\\hh.exe)) AND (file.path:(*.zip OR *.rar OR *.7z OR *.diagcab OR *.appx))"
}