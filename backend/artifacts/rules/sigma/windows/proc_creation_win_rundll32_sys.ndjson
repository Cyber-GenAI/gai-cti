  "name": "Suspicious Rundll32 Activity Invoking Sys File",
  "tags": [
    "attack.defense-evasion",
    "attack.t1218.011",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
