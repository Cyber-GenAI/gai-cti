{
  "id": "cb476052-95bf-4d04-a2cd-cc371dc588c0",
  "name": "Potential Persistence Via TypedPaths",
  "tags": [
    "attack.persistence",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects modification addition to the 'TypedPaths' key in the user or admin registry from a non standard application. Which might indicate persistence attempt",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unlikely"
  ],
  "from": "now-360s",
  "rule_id": "59793dd1-0fd9-4e5d-8622-0a088276dcd0",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
    "https://twitter.com/dez_/status/1560101453150257154",
    "https://forensafe.com/blogs/typedpaths.html"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "registry.path:*\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Explorer\\\\TypedPaths\\\\* AND (NOT (process.executable:(C\\:\\\\Windows\\\\explorer.exe OR C\\:\\\\Windows\\\\SysWOW64\\\\explorer.exe)))"
}