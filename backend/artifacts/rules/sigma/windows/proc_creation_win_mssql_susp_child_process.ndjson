    "Internal Research"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.parent.executable:*\\\\sqlservr.exe AND (process.executable:(*\\\\bash.exe OR *\\\\bitsadmin.exe OR *\\\\cmd.exe OR *\\\\netstat.exe OR *\\\\nltest.exe OR *\\\\ping.exe OR *\\\\powershell.exe OR *\\\\pwsh.exe OR *\\\\regsvr32.exe OR *\\\\rundll32.exe OR *\\\\sh.exe OR *\\\\systeminfo.exe OR *\\\\tasklist.exe OR *\\\\wsl.exe))) AND (NOT (process.parent.executable:C\\:\\\\Program\\ Files\\\\Microsoft\\ SQL\\ Server\\\\* AND process.parent.executable:*DATEV_DBENGINE\\\\MSSQL\\\\Binn\\\\sqlservr.exe AND process.executable:C\\:\\\\Windows\\\\System32\\\\cmd.exe AND process.command_line:\\\"C\\:\\\\Windows\\\\system32\\\\cmd.exe\\\"\\ *))"
}