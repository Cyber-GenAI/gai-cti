{
  "id": "1cff7f0e-97c7-4355-9452-d53806eb16b5",
  "name": "File Explorer Folder Opened Using Explorer Folder Shortcut Via Shell",
  "tags": [
    "attack.discovery",
    "attack.t1135",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the initial execution of \"cmd.exe\" which spawns \"explorer.exe\" with the appropriate command line arguments for opening the \"My Computer\" folder.\n",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "ccb1833e-0b68-4e89-87ea-f99a29e553b4",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0007",
        "name": "Discovery",
        "reference": "https://attack.mitre.org/tactics/TA0007/"
      },
      "technique": [
        {
          "id": "T1135",
          "name": "Network Share Discovery",
          "reference": "https://attack.mitre.org/techniques/T1135/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://ss64.com/nt/shell.html"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.parent.executable:(*\\\\cmd.exe OR *\\\\powershell.exe OR *\\\\pwsh.exe)) AND process.executable:*\\\\explorer.exe AND process.command_line:*shell\\:mycomputerfolder*"
}