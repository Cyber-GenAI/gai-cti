    "https://www.virustotal.com/gui/file/a864282fea5a536510ae86c77ce46f7827687783628e4f2ceb5bf2c41b8cd3c6/behavior",
    "https://admx.help/?Category=Windows_10_2016&Policy=Microsoft.Policies.WindowsDesktop::Wallpaper",
    "https://admx.help/?Category=Windows_10_2016&Policy=Microsoft.Policies.ControlPanelDisplay::CPL_Personalization_NoDesktopBackgroundUI"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:*\\\\reg.exe OR process.pe.original_file_name:reg.exe) AND process.command_line:*add*) AND (process.command_line:(*Control\\ Panel\\\\Desktop* OR *CurrentVersion\\\\Policies\\\\ActiveDesktop* OR *CurrentVersion\\\\Policies\\\\System*)) AND ((process.command_line:*\\/v\\ NoChangingWallpaper* AND process.command_line:*\\/d\\ 1*) OR (process.command_line:*\\/v\\ Wallpaper* AND process.command_line:*\\/t\\ REG_SZ*) OR (process.command_line:*\\/v\\ WallpaperStyle* AND process.command_line:*\\/d\\ 2*))"
}