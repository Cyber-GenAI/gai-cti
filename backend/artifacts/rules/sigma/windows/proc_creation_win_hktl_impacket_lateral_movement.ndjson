  "query": "((process.parent.executable:(*\\\\wmiprvse.exe OR *\\\\mmc.exe OR *\\\\explorer.exe OR *\\\\services.exe)) AND (process.command_line:*cmd.exe* AND process.command_line:*\\/Q* AND process.command_line:*\\/c* AND process.command_line:*\\\\\\\\127.0.0.1\\\\* AND process.command_line:*\\&1*)) OR ((process.parent.command_line:(*svchost.exe\\ \\-k\\ netsvcs* OR *taskeng.exe*)) AND (process.command_line:*cmd.exe* AND process.command_line:*\\/C* AND process.command_line:*Windows\\\\Temp\\\\* AND process.command_line:*\\&1*))"
