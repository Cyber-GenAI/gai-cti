  ],
  "from": "now-360s",
  "rule_id": "aa0fac09-5eaf-4048-9d6b-cc0075207edc",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0010",
        "name": "Exfiltration",
        "reference": "https://attack.mitre.org/tactics/TA0010/"
      },
      "technique": [
        {
          "id": "T1567",
          "name": "Exfiltration Over Web Service",
          "reference": "https://attack.mitre.org/techniques/T1567/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
