{
  "id": "b56c2f75-4a98-410d-b016-03ed61324753",
  "name": "IIS WebServer Access Logs Deleted",
  "tags": [
    "attack.defense-evasion",
    "attack.t1070",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the deletion of IIS WebServer access logs which may indicate an attempt to destroy forensic evidence",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "During uninstallation of the IIS service",
    "During log rotation"
  ],
  "from": "now-360s",
  "rule_id": "90b652ac-8483-4058-bb78-eeb162e32ef0",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1070",
          "name": "Indicator Removal",
          "reference": "https://attack.mitre.org/techniques/T1070/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://www.elastic.co/guide/en/security/current/webserver-access-logs-deleted.html"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "file.path:*\\\\inetpub\\\\logs\\\\LogFiles\\\\* AND file.path:*.log"
}