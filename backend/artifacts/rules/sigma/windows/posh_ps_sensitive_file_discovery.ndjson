  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(powershell.file.script_block_text:(*ls* OR *get\\-childitem* OR *gci*)) AND powershell.file.script_block_text:*\\-recurse* AND (powershell.file.script_block_text:(*.pass* OR *.kdbx* OR *.kdb*))"
}