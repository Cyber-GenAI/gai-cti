{
  "id": "05761874-7462-42ea-b2d2-7c8ca3263995",
  "name": "Potential Amazon SSM Agent Hijacking",
  "tags": [
    "attack.command-and-control",
    "attack.persistence",
    "attack.t1219",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects potential Amazon SSM agent hijack attempts as outlined in the Mitiga research report.",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate activity of system administrators"
  ],
  "from": "now-360s",
  "rule_id": "14b38062-371d-4a42-aef0-a40df0771019",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0011",
        "name": "Command And Control",
        "reference": "https://attack.mitre.org/tactics/TA0011/"
      },
      "technique": [
        {
          "id": "T1219",
          "name": "Remote Access Tools",
          "reference": "https://attack.mitre.org/techniques/T1219/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://www.mitiga.io/blog/mitiga-security-advisory-abusing-the-ssm-agent-as-a-remote-access-trojan",
    "https://www.bleepingcomputer.com/news/security/amazons-aws-ssm-agent-can-be-used-as-post-exploitation-rat-malware/",
    "https://www.helpnetsecurity.com/2023/08/02/aws-instances-attackers-access/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.executable:*\\\\amazon\\-ssm\\-agent.exe AND (process.command_line:*\\-register\\ * AND process.command_line:*\\-code\\ * AND process.command_line:*\\-id\\ * AND process.command_line:*\\-region\\ *)"
}