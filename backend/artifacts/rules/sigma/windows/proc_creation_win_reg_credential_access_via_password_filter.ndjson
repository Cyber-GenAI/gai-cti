  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.command_line:*HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Lsa* AND process.command_line:*scecli\\\\0* AND process.command_line:*reg\\ add*"
