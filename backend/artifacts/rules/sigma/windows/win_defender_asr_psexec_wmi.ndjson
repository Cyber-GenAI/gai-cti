  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects blocking of process creations originating from PSExec and WMI commands",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "68801937-1e16-409a-b6ee-a2627496ca24",
