{
  "id": "13dcfa22-7289-407a-97bf-a0e187bdc59a",
  "name": "Renamed Gpg.EXE Execution",
  "tags": [
    "attack.impact",
    "attack.t1486",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the execution of a renamed \"gpg.exe\". Often used by ransomware and loaders to decrypt/encrypt data.",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [],
  "from": "now-360s",
  "rule_id": "b253bee0-2ea5-4989-aaa5-deb3555af938",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0040",
        "name": "Impact",
        "reference": "https://attack.mitre.org/tactics/TA0040/"
      },
      "technique": [
        {
          "id": "T1486",
          "name": "Data Encrypted for Impact",
          "reference": "https://attack.mitre.org/techniques/T1486/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://securelist.com/locked-out/68960/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.pe.original_file_name:gpg.exe AND (NOT (process.executable:(*\\\\gpg.exe OR *\\\\gpg2.exe)))"
}