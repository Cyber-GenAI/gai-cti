{
  "id": "02e55c25-f433-4cfd-b071-2aeb9a5b966d",
  "name": "Suspicious Process Start Locations",
  "tags": [
    "attack.defense-evasion",
    "attack.t1036",
    "car.2013-05-002",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects suspicious process run from unusual locations",
  "risk_score": 50,
  "severity": "medium",
