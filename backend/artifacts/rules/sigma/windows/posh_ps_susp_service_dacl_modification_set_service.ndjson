  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(powershell.file.script_block_text:(*\\-SecurityDescriptorSddl\\ * OR *\\-sd\\ *)) AND ((powershell.file.script_block_text:*Set\\-Service\\ * AND powershell.file.script_block_text:*D;;*) AND (powershell.file.script_block_text:(*;;;IU* OR *;;;SU* OR *;;;BA* OR *;;;SY* OR *;;;WD*)))"
}