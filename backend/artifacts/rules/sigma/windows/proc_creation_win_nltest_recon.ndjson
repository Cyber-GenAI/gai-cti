    "attack.t1016",
    "attack.t1482",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects nltest commands that can be used for information discovery",
  "risk_score": 50,
  "severity": "medium",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate administration use but user and host must be investigated"
  ],
  "from": "now-360s",
  "rule_id": "43b7bc76-4a5d-4641-b69e-636818da53ae",
  "max_signals": 100,
  "threat": [
