  "query": "process.parent.executable:*\\\\wbem\\\\WmiPrvSE.exe AND ((process.executable:(*\\\\certutil.exe OR *\\\\cscript.exe OR *\\\\mshta.exe OR *\\\\msiexec.exe OR *\\\\regsvr32.exe OR *\\\\rundll32.exe OR *\\\\verclsid.exe OR *\\\\wscript.exe)) OR (process.executable:*\\\\cmd.exe AND (process.command_line:(*cscript* OR *mshta* OR *powershell* OR *pwsh* OR *regsvr32* OR *rundll32* OR *wscript*)))) AND (NOT (process.executable:*\\\\WerFault.exe OR process.executable:*\\\\WmiPrvSE.exe OR (process.executable:*\\\\msiexec.exe AND process.command_line:*\\/i\\ *)))"
