{
  "id": "584b86b6-ee47-4397-85f8-710440dd83ad",
  "name": "Suspicious Binary Writes Via AnyDesk",
  "tags": [
    "attack.command-and-control",
    "attack.t1219",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects AnyDesk writing binary files to disk other than \"gcapi.dll\".\nAccording to RedCanary research it is highly abnormal for AnyDesk to write executable files to disk besides gcapi.dll,\nwhich is a legitimate DLL that is part of the Google Chrome web browser used to interact with the Google Cloud API. (See reference section for more details)\n",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "aaaa709b-2ac5-49c2-a402-ee616ba49494",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0011",
        "name": "Command And Control",
        "reference": "https://attack.mitre.org/tactics/TA0011/"
      },
      "technique": [
        {
          "id": "T1219",
          "name": "Remote Access Tools",
          "reference": "https://attack.mitre.org/techniques/T1219/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://redcanary.com/blog/misbehaving-rats/",
    "https://thedfirreport.com/2025/02/24/confluence-exploit-leads-to-lockbit-ransomware/"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:(*\\\\AnyDesk.exe OR *\\\\AnyDeskMSI.exe)) AND (file.path:(*.dll OR *.exe))) AND (NOT file.path:*\\\\gcapi.dll)"
}