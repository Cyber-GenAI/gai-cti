    "https://github.com/redcanaryco/atomic-red-team/blob/02c7d02fe1f1feb0fc7944550408ea8224273994/atomics/T1112/T1112.md#atomic-test-64---disable-remote-desktop-security-settings-through-registry"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((registry.path:(*\\\\Control\\\\Terminal\\ Server\\\\* OR *\\\\Windows\\ NT\\\\Terminal\\ Services\\\\*)) AND registry.path:*\\\\Shadow AND (winlog.event_data.Details:(DWORD\\ \\(0x00000001\\) OR DWORD\\ \\(0x00000002\\) OR DWORD\\ \\(0x00000003\\) OR DWORD\\ \\(0x00000004\\)))) OR ((registry.path:(*\\\\Control\\\\Terminal\\ Server\\\\* OR *\\\\Windows\\ NT\\\\Terminal\\ Services\\\\*)) AND (registry.path:(*\\\\DisableRemoteDesktopAntiAlias OR *\\\\DisableSecuritySettings OR *\\\\fAllowUnsolicited OR *\\\\fAllowUnsolicitedFullControl)) AND winlog.event_data.Details:DWORD\\ \\(0x00000001\\)) OR (registry.path:(*\\\\Control\\\\Terminal\\ Server\\\\InitialProgram* OR *\\\\Control\\\\Terminal\\ Server\\\\WinStations\\\\RDP\\-Tcp\\\\InitialProgram* OR *\\\\services\\\\TermService\\\\Parameters\\\\ServiceDll* OR *\\\\Windows\\ NT\\\\Terminal\\ Services\\\\InitialProgram*))"
}