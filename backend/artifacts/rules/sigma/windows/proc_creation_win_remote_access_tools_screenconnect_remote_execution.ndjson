{
  "id": "230f8b09-21b2-4b79-af3b-6d976af00502",
  "name": "Remote Access Tool - ScreenConnect Remote Command Execution",
  "tags": [
    "attack.execution",
    "attack.t1059.003",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the execution of a system command via the ScreenConnect RMM service.",
  "risk_score": 20,
  "severity": "low",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate use of ScreenConnect. Disable this rule if ScreenConnect is heavily used."
  ],
  "from": "now-360s",
  "rule_id": "7b817aef-7637-48fe-b664-1e4cbdbaac67",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0002",
        "name": "Execution",
        "reference": "https://attack.mitre.org/tactics/TA0002/"
      },
      "technique": [
        {
          "id": "T1059",
          "name": "Command and Scripting Interpreter",
          "reference": "https://attack.mitre.org/techniques/T1059/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://github.com/SigmaHQ/sigma/pull/4467"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "process.parent.executable:*\\\\ScreenConnect.ClientService.exe AND (process.executable:*\\\\cmd.exe OR process.pe.original_file_name:Cmd.Exe) AND process.command_line:*\\\\TEMP\\\\ScreenConnect\\\\*"
}