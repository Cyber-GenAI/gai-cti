  "query": "(process.executable:*\\\\sdbinst.exe OR process.pe.original_file_name:sdbinst.exe) AND (NOT (process.command_line:*.sdb* OR ((process.command_line:(*\\ \\-c OR *\\ \\-f OR *\\ \\-mm OR *\\ \\-t)) OR process.command_line:*\\ \\-m\\ \\-bg*) OR (NOT _exists_:process.command_line) OR process.command_line:\"\"))"
