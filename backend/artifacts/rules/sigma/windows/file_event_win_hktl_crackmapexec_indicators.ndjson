  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "file.path:C\\:\\\\Windows\\\\Temp\\\\* AND ((file.path:(*\\\\temp.ps1 OR *\\\\msol.ps1)) OR (file.path:/\\\\[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.txt$/ OR file.path:/\\\\[a-zA-Z]{8}\\.tmp$/))"
