  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "d2061730-6271-4c5a-a1e9-086db94986a4",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
