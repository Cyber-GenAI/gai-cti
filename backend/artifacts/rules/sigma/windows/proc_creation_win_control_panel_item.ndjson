  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((process.executable:*\\\\reg.exe OR process.pe.original_file_name:reg.exe) AND (process.command_line:*add* AND process.command_line:*CurrentVersion\\\\Control\\ Panel\\\\CPLs*)) OR (process.command_line:*.cpl AND (NOT ((process.command_line:(*\\\\System32\\\\* OR *%System%* OR *\\|C\\:\\\\Windows\\\\system32\\|*)) OR (process.command_line:*regsvr32\\ * AND process.command_line:*\\ \\/s\\ * AND process.command_line:*igfxCPL.cpl*))))"
}