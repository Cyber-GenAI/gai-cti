{
  "id": "dbdcfa1d-88cf-4f1d-9165-ba0132aad3d1",
  "name": "Suspicious Dropbox API Usage",
  "tags": [
    "attack.command-and-control",
    "attack.t1105",
    "Type: GAI_CTI_SIGMA_WINDOWS"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects an executable that isn't dropbox but communicates with the Dropbox API",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate use of the API with a tool that the author wasn't aware of"
  ],
  "from": "now-360s",
  "rule_id": "1e3643fb-c9ad-471a-83ec-df6e89a8d8b3",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0011",
        "name": "Command And Control",
        "reference": "https://attack.mitre.org/tactics/TA0011/"
      },
      "technique": [
        {
          "id": "T1105",
          "name": "Ingress Tool Transfer",
          "reference": "https://attack.mitre.org/techniques/T1105/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://app.any.run/tasks/7e906adc-9d11-447f-8641-5f40375ecebb",
    "https://www.zscaler.com/blogs/security-research/new-espionage-attack-molerats-apt-targeting-users-middle-east"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(network.direction:true AND (destination.domain:(*api.dropboxapi.com OR *content.dropboxapi.com))) AND (NOT process.executable:*\\\\Dropbox*)"
}