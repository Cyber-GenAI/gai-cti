  "query": "(winlog.event_data.EventType:SetValue AND registry.path:*Classes\\\\ms\\-settings\\\\shell\\\\open\\\\command\\\\SymbolicLinkValue AND winlog.event_data.Details:*\\\\Software\\\\Classes\\\\\\{*) OR registry.path:*Classes\\\\ms\\-settings\\\\shell\\\\open\\\\command\\\\DelegateExecute OR ((winlog.event_data.EventType:SetValue AND (registry.path:(*Classes\\\\ms\\-settings\\\\shell\\\\open\\\\command\\\\\\(Default\\) OR *Classes\\\\exefile\\\\shell\\\\open\\\\command\\\\\\(Default\\)))) AND (NOT winlog.event_data.Details:\\(Empty\\)))"
