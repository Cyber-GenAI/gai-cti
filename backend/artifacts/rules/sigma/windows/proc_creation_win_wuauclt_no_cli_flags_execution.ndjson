  ],
  "from": "now-360s",
  "rule_id": "6189ac31-fa2f-45be-b279-0221ac582af5",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0005",
        "name": "Defense Evasion",
        "reference": "https://attack.mitre.org/tactics/TA0005/"
      },
      "technique": [
        {
          "id": "T1036",
          "name": "Masquerading",
          "reference": "https://attack.mitre.org/techniques/T1036/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
