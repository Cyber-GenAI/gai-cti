  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(process.executable:*\\\\rdrleakdiag.exe OR process.pe.original_file_name:RdrLeakDiag.exe) AND (process.command_line:(*\\-memdmp* OR *\\/memdmp* OR *\u2013memdmp* OR *\u2014memdmp* OR *\u2015memdmp*) OR process.command_line:(*fullmemdmp*)) AND (process.command_line:(*\\ \\-o\\ * OR *\\ \\/o\\ * OR *\\ \u2013o\\ * OR *\\ \u2014o\\ * OR *\\ \u2015o\\ *) OR process.command_line:(*\\ \\-p\\ * OR *\\ \\/p\\ * OR *\\ \u2013p\\ * OR *\\ \u2014p\\ * OR *\\ \u2015p\\ *))"
}