  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "31be7d52-646b-424c-b9fb-973c1c59f7a5",
  "max_signals": 100,
  "threat": [],
  "to": "now",
  "references": [
