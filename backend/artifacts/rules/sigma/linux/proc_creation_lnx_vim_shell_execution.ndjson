  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((Image:(*\\/rvim OR *\\/vim OR *\\/vimdiff)) AND (CommandLine:(*\\ \\-\\-cmd* OR *\\ \\-c\\ *))) AND (CommandLine:(*\\:\\!\\/* OR *\\:lua\\ * OR *\\:py\\ * OR *\\/bin\\/bash* OR *\\/bin\\/dash* OR *\\/bin\\/fish* OR *\\/bin\\/sh* OR *\\/bin\\/zsh*))"
}