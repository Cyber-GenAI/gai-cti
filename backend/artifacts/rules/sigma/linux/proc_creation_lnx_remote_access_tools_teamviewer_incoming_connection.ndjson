{
  "id": "8103d383-cde7-4262-b69d-230d735bf515",
  "name": "Remote Access Tool - Team Viewer Session Started On Linux Host",
  "tags": [
    "attack.initial-access",
    "attack.t1133",
    "Type: GAI_CTI_SIGMA_LINUX"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the command line executed when TeamViewer starts a session started by a remote host.\nOnce a connection has been started, an investigator can verify the connection details by viewing the \"incoming_connections.txt\" log file in the TeamViewer folder.\n",
  "risk_score": 20,
  "severity": "low",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate usage of TeamViewer"
  ],
  "from": "now-360s",
  "rule_id": "df2f7d01-b294-4dcf-a9c1-ff990a4ed7c4",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0001",
        "name": "Initial Access",
        "reference": "https://attack.mitre.org/tactics/TA0001/"
      },
      "technique": [
        {
          "id": "T1133",
          "name": "External Remote Services",
          "reference": "https://attack.mitre.org/techniques/T1133/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "Internal Research"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "ParentImage:*\\/TeamViewer_Service AND Image:*\\/TeamViewer_Desktop AND CommandLine:*\\/TeamViewer_Desktop\\ \\-\\-IPCport\\ 5939\\ \\-\\-Module\\ 1"
}