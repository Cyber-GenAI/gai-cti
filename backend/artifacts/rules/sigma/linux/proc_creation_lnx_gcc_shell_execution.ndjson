{
  "id": "c790501a-1d0d-4024-8aa4-eca74596da06",
  "name": "Shell Execution GCC  - Linux",
  "tags": [
    "attack.discovery",
    "attack.t1083",
    "Type: GAI_CTI_SIGMA_LINUX"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects the use of the \"gcc\" utility to execute a shell. Such behavior may be associated with privilege escalation, unauthorized command execution, or to break out from restricted environments.\n",
  "risk_score": 80,
  "severity": "high",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Unknown"
  ],
  "from": "now-360s",
  "rule_id": "12a59406-d703-46bf-b631-69e53c7201a9",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0007",
        "name": "Discovery",
        "reference": "https://attack.mitre.org/tactics/TA0007/"
      },
      "technique": [
        {
          "id": "T1083",
          "name": "File and Directory Discovery",
          "reference": "https://attack.mitre.org/techniques/T1083/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://gtfobins.github.io/gtfobins/gcc/#shell",
    "https://gtfobins.github.io/gtfobins/c89/#shell",
    "https://gtfobins.github.io/gtfobins/c99/#shell",
    "https://www.elastic.co/guide/en/security/current/linux-restricted-shell-breakout-via-linux-binary-s.html"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "((Image:(*\\/c89 OR *\\/c99 OR *\\/gcc)) AND CommandLine:*\\-wrapper*) AND (CommandLine:(*\\/bin\\/bash,\\-s* OR *\\/bin\\/dash,\\-s* OR *\\/bin\\/fish,\\-s* OR *\\/bin\\/sh,\\-s* OR *\\/bin\\/zsh,\\-s*))"
}