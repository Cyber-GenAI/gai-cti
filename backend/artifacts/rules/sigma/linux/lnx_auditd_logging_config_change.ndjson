    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "type:PATH AND (name:(\\/etc\\/syslog.conf OR \\/etc\\/rsyslog.conf OR \\/etc\\/syslog\\-ng\\/syslog\\-ng.conf))"
