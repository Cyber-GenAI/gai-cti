{
  "id": "cc362cdf-f8fa-47cc-a5dd-af9ed0240e03",
  "name": "ESXi System Information Discovery Via ESXCLI",
  "tags": [
    "attack.discovery",
    "attack.execution",
    "attack.t1033",
    "attack.t1007",
    "attack.t1059.012",
    "Type: GAI_CTI_SIGMA_LINUX"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects execution of the \"esxcli\" command with the \"system\" flag in order to retrieve information about the different component of the system. Such as accounts, modules, NTP, etc.",
