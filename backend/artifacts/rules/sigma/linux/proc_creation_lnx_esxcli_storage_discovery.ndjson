{
  "id": "e9a7f7fe-9857-4559-8d07-7de645fbea36",
  "name": "ESXi Storage Information Discovery Via ESXCLI",
  "tags": [
    "attack.discovery",
    "attack.execution",
    "attack.t1033",
    "attack.t1007",
    "attack.t1059.012",
