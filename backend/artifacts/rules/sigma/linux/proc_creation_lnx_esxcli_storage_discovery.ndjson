    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(Image:*\\/esxcli AND CommandLine:*storage*) AND (CommandLine:(*\\ get* OR *\\ list*))"
