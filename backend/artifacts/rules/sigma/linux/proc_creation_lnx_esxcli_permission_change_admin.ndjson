{
  "id": "ff3bd7d8-4480-4529-8f51-79763d50677b",
  "name": "ESXi Admin Permission Assigned To Account Via ESXCLI",
  "tags": [
    "attack.execution",
    "attack.privilege-escalation",
    "attack.t1059.012",
