{
  "id": "da23d262-2860-4c1c-bfeb-dca5df5fb57f",
  "name": "Password Policy Discovery - Linux",
  "tags": [
    "attack.discovery",
    "attack.t1201",
    "Type: GAI_CTI_SIGMA_LINUX"
  ],
  "interval": "5m",
  "enabled": true,
  "revision": 0,
  "description": "Detects password policy discovery commands",
  "risk_score": 20,
  "severity": "low",
  "author": [
    "GAI_CTI"
  ],
  "false_positives": [
    "Legitimate administration activities"
  ],
  "from": "now-360s",
  "rule_id": "e359d576-dc1d-4e8c-a32e-de0bdbf5b5bb",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0007",
        "name": "Discovery",
        "reference": "https://attack.mitre.org/tactics/TA0007/"
      },
      "technique": [
        {
          "id": "T1201",
          "name": "Password Policy Discovery",
          "reference": "https://attack.mitre.org/techniques/T1201/",
          "subtechnique": []
        }
      ]
    }
  ],
  "to": "now",
  "references": [
    "https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1201/T1201.md",
    "https://linux.die.net/man/1/chage",
    "https://man7.org/linux/man-pages/man1/passwd.1.html",
    "https://superuser.com/questions/150675/how-to-display-password-policy-information-for-a-user-ubuntu"
  ],
  "version": 1,
  "immutable": false,
  "rule_source": {
    "type": "internal"
  },
  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "(type:PATH AND (name:(\\/etc\\/login.defs OR \\/etc\\/pam.d\\/auth OR \\/etc\\/pam.d\\/common\\-account OR \\/etc\\/pam.d\\/common\\-auth OR \\/etc\\/pam.d\\/common\\-password OR \\/etc\\/pam.d\\/system\\-auth OR \\/etc\\/security\\/pwquality.conf))) OR (type:EXECVE AND a0:chage AND (a1:(\\-\\-list OR \\-l))) OR (type:EXECVE AND a0:passwd AND (a1:(\\-S OR \\-\\-status)))"
}