    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "type:PATH AND (name:(\\/etc\\/audit\\/* OR \\/etc\\/libaudit.conf OR \\/etc\\/audisp\\/*))"
