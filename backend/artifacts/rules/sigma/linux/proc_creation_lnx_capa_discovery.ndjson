  "setup": "",
  "type": "query",
  "language": "lucene",
  "index": [
    "apm-*-transaction*",
    "auditbeat-*",
    "endgame-*",
    "filebeat-*",
    "logs-*",
    "packetbeat-*",
    "traces-apm*",
    "winlogbeat-*",
    "-*elastic-cloud-logs-*",
    "mordor*",
    "*packetbeat*",
    "log*"
  ],
  "query": "Image:*\\/getcap AND CommandLine:(*\\ \\-r\\ * OR *\\ \\/r\\ * OR *\\ \u2013r\\ * OR *\\ \u2014r\\ * OR *\\ \u2015r\\ *)"
